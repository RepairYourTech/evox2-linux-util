def _as_bool(value, default=False) -> bool:
    if value is None:
        return default
    return str(value).strip().lower() in ("1", "yes", "true", "on", "y")


def load_config(path: str) -> dict:
    cfg = dict(DEFAULTS)
    parser = configparser.ConfigParser()
    if path and os.path.exists(path):
        try:
            parser.read(path)
        except (configparser.Error, OSError) as exc:
            log.warning("ignoring unreadable config %s: %s", path, exc)
            return cfg

    if parser.has_section("osd"):
        for key, value in parser.items("osd"):
            cfg[key.replace("-", "_")] = value
    if parser.has_section("icons"):
        for key, value in parser.items("icons"):
            if key in ICON_KEYS:
                cfg["icon_" + key] = value
    return cfg


def icon_for(cfg: dict, mode) -> str:
    return cfg.get("icon_" + mode.key) or mode.icon


