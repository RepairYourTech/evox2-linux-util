#!/usr/bin/env python3
"""
evo-x2-thermal-osd -- a Linux replacement for GMKtec's Windows-only
"ImagesShow" on-screen display.

The physical power-profile button on IP3-Tech Strix Halo mini-PCs (GMKtec
EVO-X1/X2, Corsair AI Workstation 300, some Beelink GTR/SER AI, ...) fires an
ACPI WMI event that no mainline driver subscribes to, and the toast that
confirms the new mode is drawn by a Windows application that has no Linux
build.  The mode itself is real, though: the embedded controller tracks it in
EC[0x31].

This daemon watches for the button (ACPI netlink event, with a slow poll as a
safety net), reads the resulting mode out of the EC, shows a desktop
notification, and optionally mirrors the choice into power-profiles-daemon so
the OS-side profile follows the hardware.

Run it as root (the EC debugfs node is root-only).  See README.md.
"""

from __future__ import annotations

import argparse
import configparser
import logging
import os
import re
import select
import shutil
import signal
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)),
                                os.pardir, "lib"))

import evo_x2_hw as hw  # noqa: E402
import evo_x2_settings as settings  # noqa: E402

PROG = "evo-x2-thermal-osd"
DEFAULT_CONFIG = "/etc/evo-x2-linux-osd.conf"

log = logging.getLogger(PROG)

DEFAULTS = {
    "user": "",
    # On the EVO-X2 the poll is the only working trigger for a button press, so
    # this is the OSD's real response time.  See docs/HOW-IT-WORKS.md section 7.
    "poll_interval": "1.0",
    "use_acpi_events": "yes",
    "sync_power_profiles": "yes",
    "sync_on_start": "no",
    "show_notifications": "yes",
    "notify_timeout_ms": "3000",
    # Re-apply the last mode at startup.  Only firmware that forgets the
    # selection across a cold boot needs this, and the switch that turns it on
    # lives in the session user's settings, so it is read from there.
    "restore_on_boot": "no",
    "log_level": "info",
}

ICON_KEYS = {m.key: m.icon for m in hw.MODES}

#: How long after a mode change further changes still count as the same event.
FLAP_WINDOW = 6.0

#: How long a reading must hold still before a burst of changes is considered
#: over.
SETTLE_SECONDS = 2.6

#: How long a burst stays open regardless of how still the reading looks.
#: Without it a flare whose individual steps are slower than SETTLE_SECONDS
#: would be closed again between two of them.  This delays only the *decision*
#: that a burst is finished, never the first report, so the panel button still
#: feels immediate.
MIN_BURST_SECONDS = 4.0

#: The start-up power-profile sync is a retry, not a one-shot call, because
#: power-profiles-daemon cannot be up yet when this daemon starts: ppd orders
#: itself after multi-user.target (it has to, so that it can order before
#: graphical.target) and this daemon is wanted by that same target.  Ordering
#: after ppd from here is an ordering cycle systemd resolves by deleting the
#: job, so the sync waits for ppd instead.  See the unit file for the detail.
PPD_STARTUP_RETRIES = 30
PPD_STARTUP_INTERVAL = 1.0


class ModeTracker:
    """Decides what a sequence of EC mode readings means.

    The EC's mode register is not always stable.  On 2026-09-21 20:59 it was
    observed to walk Quiet -> Balanced -> Performance over five seconds, with
    each value holding for two to three seconds and no button anywhere near
    it; the daemon turned that into three notifications, three power-profile
    changes and, in between, a tray icon showing a mode the machine was not in.

    No short confirmation timer can tell that apart from a real press, because
    the flare's individual steps hold for longer than a notification may
    reasonably be delayed.  What separates them is the ending: the walk came
    back to where it started.  So a change is acted on at once -- a genuine
    press has to feel immediate -- but it opens a *burst*, and further changes
    inside FLAP_WINDOW belong to that same event and are not announced again.
    When the burst stops moving the tracker reports where it landed, and the
    caller can undo the whole thing if that is where it began.

    Kept free of the EC and of the notifier so the behaviour can be tested
    without hardware: `read` and the clock are both supplied by the caller.
    """

    def __init__(self, current, now=0.0, window=FLAP_WINDOW,
                 settle=SETTLE_SECONDS, min_burst=MIN_BURST_SECONDS):
        self.mode = current
        self.origin = current
        #: The last value the caller was told to announce.  The mode in effect
        #: at startup is deliberately not announced, so it is the starting
        #: point rather than something to be reported later.
        self.announced = current
        self.last_change = now
        self.started = now
        self.window = window
        self.settle = settle
        self.min_burst = min_burst
        self.bursting = False

    def adopt(self, value, now=0.0):
        """Take `value` as the mode in effect, without announcing it.

        The daemon moves the mode itself when it restores one at boot.  A pass
        later the loop samples that new value, and to the tracker it is
        indistinguishable from a button press -- so without this a restore
        would surface as a notification about a mode the user picked yesterday.
        """
        self.mode = value
        self.origin = value
        self.announced = value
        self.last_change = now
        self.started = now
        self.bursting = False

    def update(self, value, now):
        """-> list of events, in order.

        ('changed', index)                    a new mode: report and apply it.
        ('settled', index, origin, announce)  the burst stopped.  `origin` is
            the mode in effect before it started, and `announce` says whether
            `index` still needs reporting -- False when it is the value the
            caller was already told about when the burst opened, which is the
            ordinary case of one clean mode change.
        """
        events = []
        if value is None:
            return events

        if value != self.mode:
            if self.bursting and now - self.last_change <= self.window:
                # More of the same event.  Follow it silently: whatever it
                # settles on is reported when the burst closes, so the OSD is
                # not spammed by the steps in between.
                self.mode = value
                self.last_change = now
                return events
            # A new event, whether or not the previous one ever settled.
            self.origin = self.mode
            self.mode = value
            self.announced = value
            self.last_change = now
            self.started = now
            self.bursting = True
            events.append(("changed", value))
            return events

        if (self.bursting and now - self.last_change >= self.settle
                and now - self.started >= self.min_burst):
            self.bursting = False
            announce = self.mode != self.announced
            if announce:
                self.announced = self.mode
            events.append(("settled", self.mode, self.origin, announce))
        return events


# ---------------------------------------------------------------------------
