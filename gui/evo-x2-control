#!/usr/bin/env python3
"""
evo-x2-control -- the desktop front end for the thermal-mode daemon.

Shows which thermal mode the machine is in, lets you change it, and displays the
live readings that prove the mode is doing something (clock, temperature,
package power).  It also puts an icon in the system tray with the same controls.

It runs entirely as your user: reading the mode goes through the value the daemon
publishes, and switching modes shells out to evo-x2-power through the
passwordless sudo rule the installer adds (or pkexec if you declined that).

    evo-x2-control            open the window (and the tray icon)
    evo-x2-control --tray     tray icon only; used by the autostart entry
"""

from __future__ import annotations

import configparser
import os
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, os.pardir, "lib"))
sys.path.insert(0, HERE)

CONFIG_PATH = "/etc/evo-x2-linux-osd.conf"
UNIT_NAME = "evo-x2-thermal-osd.service"
POWER_TOOL = "evo-x2-power"

#: Must match the .desktop file name, or the shell cannot find the window icon.
APP_ID = "org.evox2.Control"
APP_NAME = "Thermal Mode"
APP_ICON = "evo-x2-control"

#: Icons this package installs itself, instead of names borrowed from the icon
#: theme.  Adwaita and Yaru ship power-profile-*-symbolic and Breeze does not
#: (verified: no matches under breeze-dark, and none in hicolor either), so a
#: themed name leaves the tray icon blank on a stock KDE/Fedora/Arch desktop.
#:
#: Plain names, not -symbolic ones: plasmashell renders tray icons with Qt's SVG
#: parser, which does not implement `currentColor` (the string is absent from
#: libqsvg.so) and so drew every bar opaque black -- an invisible icon in a dark
#: panel.  The shipped icons carry explicit colours and a bar count per mode.
MODE_ICONS = {
    0: "evo-x2-quiet",
    1: "evo-x2-balanced",
    2: "evo-x2-performance",
    3: "evo-x2-sustained",
}
ICON_UNKNOWN = "evo-x2-unknown"

MENU_OPEN = 1
MODE_ITEM_BASE = 10          # 10..13 are the four modes
MENU_DIAGNOSTICS = 21
MENU_REFRESH = 22
MENU_QUIT = 24

#: An autostart entry can run before the desktop's own tray host has registered,
#: so registration is retried rather than abandoned on the first attempt.
TRAY_RETRY_ATTEMPTS = 12
TRAY_RETRY_SECONDS = 5

#: How often the tray icon re-reads the mode.  The daemon already polls the EC
#: once a second and publishes the result, so this only has to notice it.  Doing
#: it here rather than in the window is what lets the icon follow the physical
#: button while no window is open, which is the normal case for a tray app.
MODE_POLL_SECONDS = 2


def _missing_dependency(exc: Exception) -> None:
    print(f"{APP_NAME}: the graphical interface needs GTK 4 and libadwaita "
          f"({type(exc).__name__}: {exc}).\n\n"
          f"  Debian/Ubuntu : sudo apt install python3-gi gir1.2-gtk-4.0 "
          f"gir1.2-adw-1 python3-dbus\n"
          f"  Fedora        : sudo dnf install python3-gobject gtk4 libadwaita "
          f"python3-dbus\n"
          f"  Arch          : sudo pacman -S python-gobject gtk4 libadwaita "
          f"python-dbus\n\n"
          f"The daemon and the evo-x2-power command line keep working without "
          f"any of this.", file=sys.stderr)
    raise SystemExit(1)


try:
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gio, GLib, Gtk
    import dbus
    from dbus.mainloop.glib import DBusGMainLoop
except (ImportError, ValueError) as exc:      # pragma: no cover - env dependent
